[[package]]
name = "semantic-kernel"
version = "1.43.1"
source = { editable = "." }
dependencies = [
    { name = "aiohttp" },
    { name = "aiortc" },
    { name = "azure-ai-agents" },
    { name = "azure-ai-projects" },
    { name = "azure-identity" },
    { name = "cloudevents" },
    { name = "defusedxml" },
    { name = "jinja2" },
    { name = "mcp" },
    { name = "nest-asyncio" },
    { name = "numpy" },
    { name = "openai" },
    { name = "openapi-core" },
    { name = "opentelemetry-api" },
    { name = "opentelemetry-sdk" },
    { name = "prance" },
    { name = "pydantic" },
    { name = "pydantic-settings" },
    { name = "scipy", version = "1.15.3", source = { registry = "https://pypi.org/simple" }, marker = "python_full_version < '3.11'" },
    { name = "scipy", version = "1.17.1", source = { registry = "https://pypi.org/simple" }, marker = "python_full_version >= '3.11'" },
    { name = "typing-extensions" },
    { name = "websockets" },
]

[package.optional-dependencies]
anthropic = [
    { name = "anthropic" },
]
autogen = [
    { name = "autogen-agentchat" },
]
aws = [
    { name = "boto3" },
]
azure = [
    { name = "azure-ai-inference" },
    { name = "azure-core-tracing-opentelemetry" },
    { name = "azure-cosmos" },
    { name = "azure-search-documents" },
]
chroma = [
    { name = "chromadb" },
]
copilotstudio = [
    { name = "microsoft-agents-activity" },
    { name = "microsoft-agents-copilotstudio-client" },
]
faiss = [
    { name = "faiss-cpu" },
]
google = [
    { name = "google-cloud-aiplatform" },
    { name = "google-genai" },
]
hugging-face = [
    { name = "sentence-transformers" },
    { name = "torch" },
    { name = "transformers", extra = ["torch"] },
]
mcp = [
    { name = "mcp" },
]
milvus = [
    { name = "milvus", marker = "sys_platform != 'win32'" },
    { name = "pymilvus" },
]
mistralai = [
    { name = "mistralai" },
]
mongo = [
    { name = "motor" },
    { name = "pymongo" },
]
notebooks = [
    { name = "ipykernel" },
]
ollama = [
    { name = "ollama" },
]
onnx = [
    { name = "onnxruntime", version = "1.22.1", source = { registry = "https://pypi.org/simple" }, marker = "python_full_version < '3.11'" },
    { name = "onnxruntime", version = "1.27.0", source = { registry = "https://pypi.org/simple" }, marker = "python_full_version >= '3.11'" },
    { name = "onnxruntime-genai" },
]
oracledb = [
    { name = "oracledb" },
]
pandas = [
    { name = "pandas" },
]
pinecone = [
    { name = "pinecone", extra = ["asyncio", "grpc"] },
]
postgres = [
    { name = "psycopg", extra = ["binary", "pool"] },
]
qdrant = [
    { name = "qdrant-client" },
]
realtime = [
    { name = "aiortc" },
    { name = "websockets" },
]
redis = [
    { name = "redis", extra = ["hiredis"] },
    { name = "redisvl" },
    { name = "types-redis" },
]
sql = [
    { name = "pyodbc" },
]
usearch = [
    { name = "pyarrow" },
    { name = "usearch" },
]
weaviate = [
    { name = "weaviate-client" },
]

[package.dev-dependencies]
dev = [
    { name = "ipykernel" },
    { name = "mypy" },
    { name = "nbconvert" },
    { name = "pre-commit" },
    { name = "pytest" },
    { name = "pytest-asyncio" },
    { name = "pytest-cov" },
    { name = "pytest-timeout" },
    { name = "pytest-xdist", extra = ["psutil"] },
    { name = "ruff" },
    { name = "snoop" },
    { name = "types-pyyaml" },
]

